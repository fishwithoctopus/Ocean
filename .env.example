# Ocean Gateway only. Copy to a private server environment; never expose these
# values through VITE_* variables or commit a populated .env file.
PORT=8787
OCEAN_GATEWAY_HOST=127.0.0.1
OCEAN_ACCESS_PASSWORD_B64=
OCEAN_DEFAULT_PROVIDER=mock
OCEAN_SYSTEM_PROMPT=You are the companion speaking inside Ocean. Preserve continuity, be honest about unavailable tools, and answer naturally.
# Optional private multiline profile encoded as UTF-8 Base64. Takes precedence over OCEAN_SYSTEM_PROMPT.
OCEAN_SYSTEM_PROMPT_B64=

# Session Forge. One turn means a user message plus its assistant reply. The
# summary provider is intentionally blank by default, so background forging does
# not create an additional model charge.
OCEAN_FORGE_THRESHOLD_UNITS=12000
OCEAN_FORGE_RESERVE_UNITS=2000
OCEAN_FORGE_RECENT_TURNS=20
OCEAN_FORGE_SUMMARY_PROVIDER=
OCEAN_FORGE_SUMMARY_MODEL=

# Optional chat picker allowlist. Use composite provider:model IDs separated by
# commas. Leave blank to expose every configured provider model.
OCEAN_CHAT_MODELS=

# Direct providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Kimi API (Moonshot). Create the key at https://platform.kimi.com/
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3

# Alibaba Cloud Model Studio / Qwen (China Beijing shared endpoint)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.6-sol

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-4-8

# Unified relay. Set the model explicitly to an OpenRouter model slug.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Ocean

# Optional additional OpenAI-compatible relays. Keys are referenced by env name,
# never embedded in this JSON. Keep the JSON on one line in the real environment.
# OCEAN_OPENAI_COMPAT_PROVIDERS_JSON=[{"id":"my-relay","name":"My Relay","baseUrl":"https://relay.example.com/v1","apiKeyEnv":"MY_RELAY_API_KEY","defaultModel":"model-id","models":["model-id"]}]
# MY_RELAY_API_KEY=

# Existing internal services
CO_READING_BASE_URL=http://127.0.0.1:8788
CO_READING_AUTH_TOKEN=
# Free-time uses an independent model so background cost never follows the
# currently selected chat model. Automatic calls require the explicit gate.
FREE_TIME_PROVIDER_ID=kimi
FREE_TIME_MODEL_ID=kimi-k3
FREE_TIME_AUTO_DISPATCH=disabled
FREE_TIME_DISPATCH_URL=

# Optional personal-use fishing engine. Ocean does not redistribute the
# PolyForm-Noncommercial upstream source; point this at your own fishing.py.
FISHING_GAME_SCRIPT_PATH=
FISHING_PYTHON_BIN=python3

# Optional private NetEase Cloud Music session location. Login is completed by
# QR code in Ocean settings; no password or cookie belongs in an env file.
OCEAN_NETEASE_SESSION_PATH=server/data/netease-session.json

# Optional personal Notion project mirror. Create an internal Notion connection,
# share one private parent page with it, then keep both values only on the
# Gateway. Ocean Server remains the source of truth; this adapter mirrors the
# project overview, project documents and file names into managed child pages.
NOTION_ACCESS_TOKEN=
OCEAN_NOTION_PARENT_PAGE_ID=
# enabled: mirror again after project/workspace saves; disabled: manual button.
OCEAN_NOTION_AUTO_SYNC=disabled
# Current official API version. Override only for a deliberate migration.
NOTION_API_VERSION=2026-03-11

# Optional Ocean Memory 3.0 connection. Deploy the compatible Ombre-Brain fork
# independently (https://github.com/Yinglianchun/Ombre-Brain), then point this
# server-only URL at its Streamable HTTP MCP endpoint. Leave it empty to keep
# Ocean in local-first mode with Gateway candidate staging only.
OCEAN_MEMORY_MCP_URL=
OCEAN_MEMORY_AUTH_TOKEN=
# staging: never auto-commit; explicit: only explicit "remember" requests;
# direct: also commit automatic threshold candidates.
OCEAN_MEMORY_WRITE_MODE=staging
# Server-side retrieval for chat. Recall is independent from long-term writes:
# disabling this keeps Memory pages available but omits Memory from chat prompts.
OCEAN_CHAT_MEMORY_RECALL=enabled
OCEAN_CHAT_MEMORY_RESULTS=4
OCEAN_CHAT_MEMORY_CHARACTERS=3200
OCEAN_OPENROUTER_PROMPT_CACHE=enabled

# Daily paper notes. Ocean derives tomorrow's four notes from today's completed
# Memory daily impression, stores one idempotent package on the Gateway, reveals
# notes by local time, and can deliver them through Web Push. Provider/model are
# optional: when blank, Ocean prefers a configured OpenRouter provider and then
# the first configured real provider.
OCEAN_TIME_ZONE=Asia/Shanghai
PAPER_NOTE_PROVIDER_ID=
PAPER_NOTE_MODEL_ID=

# Web Push requires a public/private VAPID key pair and a contact subject.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Client build: development may use localhost. In production prefer a same-origin
# reverse proxy such as /api rather than a public raw Gateway port.
VITE_OCEAN_GATEWAY_URL=http://127.0.0.1:8787
VITE_OCEAN_BASE_PATH=/
